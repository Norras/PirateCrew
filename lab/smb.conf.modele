# Modèle de configuration Samba du lab — rempli par lab/demarrer.sh
# (@DONNEES@ = répertoire de travail, @QUI@ = utilisateur qui lance le service).
# smbd tourne sans root : tous ses répertoires d'état sont dans @DONNEES@/samba.
[global]
   workgroup = SEPTMERS
   server string = Serveur de fichiers du Comptoir (lab)
   netbios name = SRV-INTRANET
   server role = standalone server
   interfaces = 192.0.2.2/30
   bind interfaces only = yes
   smb ports = 445
   disable netbios = yes
   map to guest = Bad User
   guest account = @QUI@
   # Le compte fictif svc-sauvegarde est porté par l'utilisateur qui lance smbd :
   # aucun compte système n'est créé.
   passdb backend = tdbsam:@DONNEES@/samba/private/passdb.tdb
   username map = @DONNEES@/samba/comptes.map
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = @DONNEES@/samba/smbd.log
   lock directory = @DONNEES@/samba/lock
   state directory = @DONNEES@/samba/state
   cache directory = @DONNEES@/samba/cache
   pid directory = @DONNEES@/samba/pid
   private dir = @DONNEES@/samba/private
   ncalrpc dir = @DONNEES@/samba/ncalrpc

[public]
   comment = Partage public
   path = @DONNEES@/partage/public
   guest ok = yes
   read only = yes

[archives]
   comment = Archives comptabilite
   path = @DONNEES@/partage/archives
   guest ok = no
   valid users = @QUI@
   read only = yes
