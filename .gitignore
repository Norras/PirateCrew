# === Secrets — NEVER commit ===
.env
.env.*
*.key

# === Python virtual environment ===
venv/
.venv/
env/

# === Python caches / build ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# === RAG vector store (generated from htb_notes, large & regenerable) ===
chroma_db/

# === Personal HTB notes — kept LOCAL only (operator's choice) ===
htb_notes/

# === Authorization scope — operator's real perimeter stays LOCAL (only scope.txt.example is versioned) ===
scope.txt

# === Runtime / audit artifacts ===
audit.log
*.log

# === Autonomous missions (state + per-mission artifacts, contains secrets) ===
missions/

# === Artifacts dropped in the cwd by a tool (-o), e.g. a gobuster technique ===
# (name + content carry the target: never version them)
gobuster_*.txt
ffuf_*.json

# === Editor / IDE ===
.vscode/
.idea/

# === OS cruft ===
Thumbs.db
.DS_Store

# === SDD scratch (superpowers subagent-driven workspace) ===
.superpowers/

# === Operator attack templates — real arsenal stays LOCAL (dir kept via .gitkeep) ===
catalog/operator/*.yaml
